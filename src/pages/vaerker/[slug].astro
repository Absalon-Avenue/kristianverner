---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Side from '../../layouts/Side.astro';
import { vaerker, indstillinger, statusTekst } from '../../lib/indhold';
import { billederTil } from '../../lib/billeder';
import { sti } from '../../lib/sti';

export async function getStaticPaths() {
  const alle = await vaerker();
  return alle.map((v, n) => ({
    params: { slug: v.id },
    props: { vaerk: v, forrige: alle[n - 1] ?? null, naeste: alle[n + 1] ?? null },
  }));
}

const { vaerk, forrige, naeste } = Astro.props;
const d = vaerk.data;
const i = await indstillinger();
const { Content } = await render(vaerk);
const harTekst = (vaerk.body ?? '').trim().length > 0;
const [stort, ...flere] = billederTil(vaerk.id);

const med_aar = [d.titel, d.aar].filter(Boolean).join(', ');
const alt = med_aar + (d.materiale ? `. ${d.materiale}` : '');
const visPris = i.vis_priser === true && d.pris;
const raekker = [
  ['År', d.aar],
  ['Materiale', d.materiale],
  ['Mål', d.maal],
  ['Vægt', d.vaegt],
  ['Pris', visPris ? d.pris : ''],
  ['Status', d.status ? statusTekst(d.status) : ''],
].filter(([, v]) => v);

const delebillede = stort ? (await getImage({ src: stort, width: 1200, format: 'jpg' })).src : undefined;
const punktum = (t: string) => (/[.!?]$/.test(t) ? t : `${t}.`);
const beskrivelse = [d.kort, [d.kategori, d.materiale, d.maal].filter(Boolean).join(', '), `Værk af ${i.navn}`]
  .filter(Boolean)
  .map(punktum)
  .join(' ')
  .slice(0, 300);

const data = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: d.titel,
  dateCreated: d.aar || undefined,
  artform: d.kategori || undefined,
  artMedium: d.materiale || undefined,
  description: d.kort || undefined,
  creator: { '@id': `${new URL(sti('/'), Astro.site).href}#kristian` },
  image: delebillede ? new URL(delebillede, Astro.site).href : undefined,
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---
<Side titel={`${med_aar} | ${i.navn}`} beskrivelse={beskrivelse} aktiv="vaerker" delebillede={delebillede} ekstraData={data}>
  <article>
    <div class="ramme vtop">
      <a class="tilbage" href={sti('/vaerker/')}><span aria-hidden="true">←</span> Værker</a>
      <p class="maerke" style="margin-bottom:18px">{[d.kategori, d.aar].filter(Boolean).join(', ')}</p>
      <h1 class="stor">{d.titel}</h1>
      {d.kort && <p class="under">{d.kort}</p>}
    </div>

    {stort && (
      <div class="vstort">
        <Image src={stort} alt={alt} widths={[800, 1200, 1600, 2200]} sizes="100vw" loading="eager" />
      </div>
    )}

    <div class="ramme afsnit" style="padding-bottom:clamp(48px,7vw,100px)">
      <div class:list={['vkrop', { 'uden-tekst': !harTekst }]}>
        {harTekst && <div class="prosa"><Content /></div>}
        <aside class="vside">
          {raekker.length > 0 && (
            <dl class="data">
              {raekker.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
            </dl>
          )}
          <a class="knap" href={sti(`/kontakt/?vaerk=${encodeURIComponent(med_aar)}`)} data-umami-event="Forespørgsel" data-umami-event-vaerk={d.titel}>Spørg til værket</a>
        </aside>
      </div>
    </div>

    {flere.length > 0 && (
      <div class="ramme" style="padding-bottom:clamp(60px,9vw,130px)">
        <div class="vflere">
          {flere.map((b, n) => (
            <figure>
              <Image src={b} alt={`${med_aar}, billede ${n + 2}`} widths={[640, 1000, 1500]} sizes="(min-width: 620px) 46vw, 92vw" />
            </figure>
          ))}
        </div>
        {d.foto && <p class="fotokredit">Foto: {d.foto}</p>}
      </div>
    )}

    <div class="ramme">
      <nav class="naeste" aria-label="Flere værker">
        {forrige && (
          <a href={sti(`/vaerker/${forrige.id}/`)}>
            <span class="maerke">Forrige</span><span class="titel">{forrige.data.titel}</span>
          </a>
        )}
        {naeste && (
          <a class="frem" href={sti(`/vaerker/${naeste.id}/`)}>
            <span class="maerke">Næste</span><span class="titel">{naeste.data.titel}</span>
          </a>
        )}
      </nav>
    </div>
  </article>
</Side>
