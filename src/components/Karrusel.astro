<script>
  // Styrer alle billedkarruseller på siden. Én gang pr. side.
  const ro = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-karrusel]').forEach((kort) => {
    if (kort.hasAttribute('data-glider')) return toning(kort);
    const spor = kort.querySelector<HTMLElement>('.spor')!;
    const prikker = [...kort.querySelectorAll<HTMLElement>('.prikker span')];
    const antal = prikker.length;
    const nu = () => Math.round(spor.scrollLeft / spor.clientWidth);
    const gaaTil = (i: number) =>
      spor.scrollTo({ left: ((i + antal) % antal) * spor.clientWidth, behavior: ro ? 'auto' : 'smooth' });
    const marker = () => prikker.forEach((p, i) => p.classList.toggle('aktiv', i === nu()));
    kort.querySelector('.tilbage')?.addEventListener('click', () => gaaTil(nu() - 1));
    kort.querySelector('.frem')?.addEventListener('click', () => gaaTil(nu() + 1));
    let vent = 0;
    spor.addEventListener('scroll', () => { cancelAnimationFrame(vent); vent = requestAnimationFrame(marker); }, { passive: true });
    marker();
  });

  // Værker med `glider: true`: billederne toner blødt over i hinanden, mens det viste billede
  // langsomt kommer en anelse tættere på. Det sker af sig selv, når kortet har været på skærmen
  // et par sekunder. Pilene, prikkerne og et stryg med fingeren virker stadig.
  function toning(kort: HTMLElement) {
    kort.classList.add('toning');
    const slides = [...kort.querySelectorAll<HTMLElement>('.slide')];
    const prikker = [...kort.querySelectorAll<HTMLElement>('.prikker span')];
    const antal = slides.length;
    let aktiv = 0, synlig = false, timer = 0;
    const vis = (i: number) => {
      aktiv = (i + antal) % antal;
      slides.forEach((s, n) => {
        const er = n === aktiv;
        s.classList.toggle('aktiv', er);
        s.setAttribute('aria-hidden', er ? 'false' : 'true');
        s.tabIndex = er ? 0 : -1;
      });
      prikker.forEach((p, n) => p.classList.toggle('aktiv', n === aktiv));
    };
    const naeste = () => {
      clearTimeout(timer);
      if (ro || !synlig || document.hidden) return;
      timer = window.setTimeout(() => { vis(aktiv + 1); naeste(); }, 4200);
    };
    const selv = (i: number) => { vis(i); naeste(); };
    kort.querySelector('.tilbage')?.addEventListener('click', () => selv(aktiv - 1));
    kort.querySelector('.frem')?.addEventListener('click', () => selv(aktiv + 1));
    let x0 = 0;
    kort.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    kort.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) selv(aktiv + (dx < 0 ? 1 : -1));
    }, { passive: true });
    new IntersectionObserver(([e]) => { synlig = e.intersectionRatio > 0.5; naeste(); }, { threshold: [0, 0.5, 1] }).observe(kort);
    document.addEventListener('visibilitychange', naeste);
    vis(0);
  }
</script>
