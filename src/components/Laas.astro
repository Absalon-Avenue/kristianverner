---
// Logo og navn. Med `fast` bliver logoet stående i hjørnet, og navnet trækker sig ind i logoet,
// når man scroller ned. Det kommer ud igen, når man er tilbage i toppen.
import Logo from './Logo.astro';
import { sti } from '../lib/sti';
const { navn, tegnes = false, fast = false } = Astro.props;
---
<a class:list={['laas', { fast }]} href={sti('/')} aria-label={`${navn}, forside`}>
  <span class="segl"><Logo tegnes={tegnes} /></span>
  <span class="tekst"><span class="navn">{navn}</span><span class="streg"></span></span>
</a>
