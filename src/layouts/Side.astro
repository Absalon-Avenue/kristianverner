---
import '@fontsource-variable/albert-sans';
// Cormorant bruges kun til navnet øverst på forsiden.
import '@fontsource/cormorant-garamond/300.css';
import '../stil/global.css';
import Laas from '../components/Laas.astro';
import Lys from '../components/Lys.astro';
import Tommelmenu from '../components/Tommelmenu.astro';
import Karrusel from '../components/Karrusel.astro';
import { getCollection } from 'astro:content';
import { indstillinger } from '../lib/indhold';
import { sti } from '../lib/sti';
import { ord, adresse as sideAdresse, LOCALE, SPROGLISTE, SPROGNAVN, type Sprog } from '../lib/sprog';

// sprog: sidens sprog. alternativer: den samme side på de andre sprog, fx { fr: '/fr/', en: '/en/', da: '/' }.
const { titel, beskrivelse = '', overVideo = false, aktiv = '', delebillede, ekstraData, sprog = 'da' as Sprog, alternativer } = Astro.props;
const i = await indstillinger(sprog);
// Linket til værkstedet vises kun, når der er mindst ét opslag.
const harVaerksted = (await getCollection('vaerksted')).some((o) => !o.data.kladde);
const t = ord(sprog);
const adresse = new URL(Astro.url.pathname, Astro.site).href;
const rod = new URL(sti('/'), Astro.site).href;
const andre = alternativer ?? { da: sti('/'), en: sideAdresse('en', 'forside'), fr: sideAdresse('fr', 'forside') };
const og = new URL(delebillede ?? sti('/og.jpg'), Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${rod}#kristian`,
  name: i.navn,
  alternateName: i.ogsaa_kendt_som ?? [],
  jobTitle: i.fag,
  birthDate: i.foedt || undefined,
  url: rod,
  sameAs: i.profiler ?? [],
  alumniOf: i.uddannelse ? { '@type': 'CollegeOrUniversity', name: i.uddannelse } : undefined,
  award: i.priser ?? undefined,
  worksFor: {
    '@type': 'Organization',
    name: i.firmanavn,
    url: rod,
    vatID: i.cvr ? `DK${i.cvr}` : undefined,
    address: i.adresse,
  },
};
// Måling kører kun på det færdige site, ikke mens der arbejdes lokalt.
const maal = import.meta.env.PROD && i.umami_id;
const menu = [
  { href: sideAdresse(sprog, 'vaerker'), tekst: t.vaerker, id: 'vaerker' },
  { href: sideAdresse(sprog, 'om'), tekst: t.om, id: 'om' },
  { href: sideAdresse(sprog, 'kontakt'), tekst: t.kontakt, id: 'kontakt' },
];
---
<!doctype html>
<html lang={sprog}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <slot name="hoved" />
    <title>{titel}</title>
    {beskrivelse && <meta name="description" content={beskrivelse} />}
    <link rel="canonical" href={adresse} />
    {alternativer && SPROGLISTE.map((s) => <link rel="alternate" hreflang={s} href={new URL(alternativer[s], Astro.site).href} />)}
    {alternativer && <link rel="alternate" hreflang="x-default" href={new URL(alternativer.da, Astro.site).href} />}
    <link rel="icon" type="image/svg+xml" href={sti('/favicon.svg')} />
    <link rel="sitemap" href={sti('/sitemap-index.xml')} />
    <meta name="theme-color" content="#f8f6f2" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={i.firmanavn} />
    <meta property="og:title" content={titel} />
    {beskrivelse && <meta property="og:description" content={beskrivelse} />}
    <meta property="og:url" content={adresse} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={LOCALE[sprog]} />
    <meta name="twitter:card" content="summary_large_image" />
    {i.google_verifikation && <meta name="google-site-verification" content={i.google_verifikation} />}
    {maal && <script defer src="https://cloud.umami.is/script.js" data-website-id={i.umami_id}></script>}
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {ekstraData && <script type="application/ld+json" set:html={JSON.stringify(ekstraData)} />}
  </head>
  <body>
    <Lys />
    <header class:list={['top', { 'over-video': overVideo }]}>
      <Laas navn={i.firmanavn} tegnes={overVideo} fast hjem={sideAdresse(sprog, 'forside')} hjemTekst={t.forside} />
    </header>

    <Tommelmenu menu={menu} aktiv={aktiv} etiket={t.menu} />

    <main><slot /></main>
    <Karrusel />
    <script>
      // Navnet trækker sig ind i logoet, når man har scrollet lidt ned.
      const rod = document.documentElement;
      let vent = 0;
      // Logo og menu bliver lyse, når de står oven på et mørkt felt (videoen, citatfeltet).
      const faste = [...document.querySelectorAll<HTMLElement>('.laas.fast, .tommel a')];
      const moerke = [...document.querySelectorAll<HTMLElement>('[data-moerk]')];
      const tjek = () => {
        const y = scrollY;
        if (y > 90) rod.classList.add('samlet');
        else if (y < 40) rod.classList.remove('samlet');
        faste.forEach((el) => {
          const r = el.getBoundingClientRect();
          const midt = r.top + r.height / 2;
          const over = moerke.some((m) => { const b = m.getBoundingClientRect(); return midt >= b.top && midt <= b.bottom; });
          el.classList.toggle('paa-moerk', over);
        });
      };
      addEventListener('scroll', () => { cancelAnimationFrame(vent); vent = requestAnimationFrame(tjek); }, { passive: true });
      // Tjek igen, når siden har lagt sig helt til rette. Telefoner måler ofte forkert lige ved start.
      tjek();
      ['load', 'resize', 'pageshow', 'orientationchange'].forEach((h) => addEventListener(h, tjek));
      setTimeout(tjek, 300);
      requestAnimationFrame(() => requestAnimationFrame(() => { tjek(); rod.classList.add('i-gang'); }));
    </script>

    <footer class="bund">
      <div class="ramme raekke">
        <div class="bundvenstre">
          <Laas navn={i.firmanavn} hjem={sideAdresse(sprog, 'forside')} hjemTekst={t.forside} />
          {harVaerksted && <a class="bundlink" href={sideAdresse(sprog, 'vaerksted')}>{t.vaerksted}</a>}
        </div>
        <div class="bundhoejre">
        <nav class="bundsprog" aria-label={t.vaelgSprog}>
          {SPROGLISTE.map((s) => (
            <a href={andre[s]} hreflang={s} lang={s} data-sprog={s} aria-current={s === sprog ? 'true' : undefined}>{SPROGNAVN[s]}</a>
          ))}
        </nav>
        <p class="oplysninger">
          {i.adresse}<br />
          CVR {i.cvr}
          {i.instagram && <> · <a href={`https://www.instagram.com/${i.instagram}/`} rel="me noopener" data-umami-event="Instagram" data-umami-event-sted="bund">Instagram</a></>}
          {i.website_af && (
            <>
              <br />Website:
              {i.website_af_link ? <a href={i.website_af_link} rel="noopener">{i.website_af}</a> : i.website_af}
            </>
          )}
        </p>
        </div>
      </div>
    </footer>
    <script>
      // Sitet husker det sprog, man har valgt, så introen ikke spørger igen næste gang.
      document.querySelectorAll<HTMLAnchorElement>('.bundsprog [data-sprog]').forEach((a) =>
        a.addEventListener('click', () => { try { localStorage.setItem('sprog', a.dataset.sprog!); } catch {} }),
      );
    </script>
  </body>
</html>
