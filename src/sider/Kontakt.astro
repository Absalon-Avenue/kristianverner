---
import Side from '../layouts/Side.astro';
import { side, indstillinger, paaSprog } from '../lib/indhold';
import { ord, adresse, alleSprog, type Sprog } from '../lib/sprog';

const { sprog = 'da' as Sprog } = Astro.props;
const t = ord(sprog);
const kontakt = await paaSprog(await side('kontakt'), sprog, 'sider');
const k = kontakt.data as Record<string, any>;
const i = await indstillinger(sprog);
const { Content, harTekst, tekstSprog } = kontakt;
const tlf = String(i.telefon ?? '').replace(/\s/g, '');
// Emnet sendes altid på dansk til Kristian, men vises på besøgendes sprog.
const danske = ord('da').emner;
const emner = t.emner.map((tekst, n) => ({ vaerdi: danske[n], tekst }));
---
<Side titel={k.titel} beskrivelse={k.beskrivelse} aktiv="kontakt" sprog={sprog} alternativer={alleSprog((s) => adresse(s, 'kontakt'))}>
  <section class="afsnit" style="padding-top:clamp(30px,5vw,80px)">
    <div class="ramme kontakt">
      <div>
        <h1 class="stor">{t.kontakt}</h1>
        {harTekst && <div class="prosa" style="margin-top:30px" lang={tekstSprog !== sprog ? tekstSprog : undefined}><Content /></div>}
        <p class="direkte">
          <a href={`mailto:${i.email}`} data-umami-event="Kontakt" data-umami-event-emne="Mail direkte">{i.email}</a><br />
          {i.telefon && <><a href={`tel:${tlf}`} data-umami-event="Kontakt" data-umami-event-emne="Telefon">{i.telefon}</a><br /></>}
          {i.instagram && <a href={`https://www.instagram.com/${i.instagram}/`} rel="me noopener" data-umami-event="Instagram" data-umami-event-sted="kontakt">Instagram @{i.instagram}</a>}
        </p>
      </div>

      <div class="formular-felt">
        <form class="formular" id="formular" data-noegle={i.formular_noegle || ''} data-email={i.email} data-tak={k.tak || t.takStandard} data-sprog={sprog} data-interesseret={t.interesseret} data-udfyld={t.udfyld} data-fejl={t.kunneIkkeSendes} data-send={t.send} data-sender={t.sender} novalidate>
          {k.formular_titel && <h2 class="mellem" style="margin-bottom:34px">{k.formular_titel}</h2>}
          <label class="felt">
            <span>{t.hvadDrejerDet}</span>
            <select name="emne" required>
              {emner.map((e) => <option value={e.vaerdi}>{e.tekst}</option>)}
            </select>
          </label>
          <label class="felt">
            <span>{t.navn}</span>
            <input name="name" type="text" autocomplete="name" required />
          </label>
          <label class="felt">
            <span>{t.email}</span>
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label class="felt">
            <span>{t.telefon} <em>{t.ringesOp}</em></span>
            <input name="telefon" type="tel" autocomplete="tel" />
          </label>
          <label class="felt">
            <span>{t.besked}</span>
            <textarea name="besked" rows="6" required></textarea>
          </label>
          <input type="checkbox" name="botcheck" class="kun-skaermlaeser" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <p class="formular-fejl" role="alert" hidden></p>
          <button class="knap" type="submit">{t.send}</button>
          <p class="formular-note">{t.note}</p>
        </form>
        <div class="formular-tak" id="tak" role="status" hidden></div>
      </div>
    </div>
  </section>
</Side>

<script>
  const f = document.querySelector<HTMLFormElement>('#formular');
  if (f) {
    // Kommer man fra et værk, står emnet og værket allerede skrevet ind.
    const q = new URLSearchParams(location.search);
    const vaerk = q.get('vaerk');
    const emne = q.get('emne');
    const sel = f.querySelector<HTMLSelectElement>('[name=emne]')!;
    const besked = f.querySelector<HTMLTextAreaElement>('[name=besked]')!;
    if (emne && [...sel.options].some((o) => o.value === emne)) sel.value = emne;
    else if (vaerk) sel.value = 'Køb af et værk';
    if (vaerk) besked.value = `${f.dataset.interesseret} ${vaerk}.\n\n`;

    const fejl = f.querySelector<HTMLElement>('.formular-fejl')!;
    const knap = f.querySelector<HTMLButtonElement>('button[type=submit]')!;
    const vis = (t: string) => { fejl.textContent = t; fejl.hidden = !t; };

    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      vis('');
      if (!f.checkValidity()) {
        vis(f.dataset.udfyld ?? '');
        f.reportValidity();
        return;
      }
      const d = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      if (d.botcheck) return;
      const noegle = f.dataset.noegle;
      const sprogtekst = f.dataset.sprog === 'da' ? '' : ` (${f.dataset.sprog?.toUpperCase()})`;
      const emnelinje = `${d.emne}: henvendelse via kristianverner.dk${sprogtekst}`;

      // Uden nøgle: åbn folks eget mailprogram med beskeden skrevet ind.
      if (!noegle) {
        const krop = `${d.besked}\n\n${d.name}\n${d.email}${d.telefon ? `\n${d.telefon}` : ''}`;
        location.href = `mailto:${f.dataset.email}?subject=${encodeURIComponent(emnelinje)}&body=${encodeURIComponent(krop)}`;
        return;
      }

      knap.disabled = true;
      knap.textContent = f.dataset.sender ?? '';
      try {
        const svar = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: noegle,
            subject: emnelinje,
            from_name: 'kristianverner.dk',
            name: d.name,
            email: d.email,
            telefon: d.telefon || '',
            emne: d.emne,
            besked: d.besked,
          }),
        }).then((r) => r.json());
        if (!svar.success) throw new Error(svar.message);
        (window as any).umami?.track?.('Kontaktformular', { emne: d.emne });
        const tak = document.querySelector<HTMLElement>('#tak')!;
        tak.textContent = f.dataset.tak || 'Tak for din besked.';
        tak.hidden = false;
        f.hidden = true;
      } catch {
        vis(`${f.dataset.fejl} ${f.dataset.email}.`);
        knap.disabled = false;
        knap.textContent = f.dataset.send ?? '';
      }
    });
  }
</script>
